<Project Sdk="Microsoft.NET.Sdk">

  <!-- The wallpaper app with its card. The wall under the desktop icons on every screen, an icon in the tray that opens
       the card. The picture (wall.html), the scene pictures, the grain and the fonts are the Mac app's own, kept in
       ../shared exactly as the Mac app has them (see shared/README.md) and linked in at build time. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection: Windows.Devices.Geolocation for the place (Locator.cs). Runs on Windows 10 1809 and later. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Hidamari</AssemblyName>
    <RootNamespace>Hidamari</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- the app's own icon (Task Manager, Windows' dialogs, the file itself): the package's icon at its exact sizes,
         16–256 px, put together from Package/Images/Square44x44Logo.targetsize-*.png -->
    <ApplicationIcon>Resources\Hidamari.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- the Windows app's own numbers, from 1.0 (Ed, 23 November 2026); 1.1 = the Mac's update 1.4; ci/package.ps1 passes the package's -->
    <Version>1.1.0</Version>
    <Product>Hidamari</Product>
    <Company>Hidamari</Company>
    <!-- lets the project build on any machine (the compile check runs on Linux), the app runs on Windows only -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- One file to hand over: dotnet publish -c Release -r win-x64 (see README.md) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- Direct3D for the wall's drawing (Wall/D3DWall.cs), DirectComposition to show it (and for the web frames on the raised desktop) -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\shared\wall.html" Link="wall.html" LogicalName="wall.html" />
    <!-- the Direct3D drawing (stage 4): the shader, and the Mac's Metal textures as they are (shared/textures) -->
    <EmbeddedResource Include="Wall\wall.hlsl" LogicalName="wall.hlsl" />
    <EmbeddedResource Include="..\shared\textures\*.htex.gz" Link="Wall\textures\%(Filename)%(Extension)" LogicalName="textures/%(Filename)%(Extension)" />
    <!-- Mac update 1.4: the photo plants cut into pieces, for the window's plant in the wind (Core/WindowLeaves.cs) -->
    <EmbeddedResource Include="..\shared\textures\rig*.json" Link="Wall\textures\%(Filename)%(Extension)" LogicalName="textures/%(Filename)%(Extension)" />
    <!-- tray icons, made from the Hidamari menu bar sign of the Mac app -->
    <EmbeddedResource Include="Resources\tray-black.ico" LogicalName="tray-black.ico" />
    <EmbeddedResource Include="Resources\tray-white.ico" LogicalName="tray-white.ico" />
    <EmbeddedResource Include="Resources\Hidamari.ico" LogicalName="Hidamari.ico" />
    <!-- the place search's own list of cities, from GeoNames (tools/make-cities.py) -->
    <EmbeddedResource Include="Resources\cities.gz" LogicalName="cities.gz" />
    <!-- the card (Card.cs): its page, and what the page uses -->
    <EmbeddedResource Include="Card\card.html" LogicalName="card/card.html" />
    <EmbeddedResource Include="Card\card.css" LogicalName="card/card.css" />
    <EmbeddedResource Include="Card\card.js" LogicalName="card/card.js" />
    <!-- the sky's colours, shared by the card and the support window; the support window's page (the Mac's update 1.4)
         and the app's icon on it -->
    <EmbeddedResource Include="Card\sky.js" LogicalName="card/sky.js" />
    <EmbeddedResource Include="Card\support.html" LogicalName="card/support.html" />
    <EmbeddedResource Include="Card\support.css" LogicalName="card/support.css" />
    <EmbeddedResource Include="Card\support.js" LogicalName="card/support.js" />
    <EmbeddedResource Include="..\Package\Images\Square44x44Logo.targetsize-256.png" Link="Card\icon.png" LogicalName="card/img/icon.png" />
    <EmbeddedResource Include="..\shared\grain.png" Link="Card\grain.png" LogicalName="card/img/grain.png" />
    <EmbeddedResource Include="..\shared\fonts\IBMPlexMono-Regular.ttf" Link="Card\IBMPlexMono-Regular.ttf" LogicalName="card/fonts/IBMPlexMono-Regular.ttf" />
    <EmbeddedResource Include="..\shared\fonts\IBMPlexMono-Medium.ttf" Link="Card\IBMPlexMono-Medium.ttf" LogicalName="card/fonts/IBMPlexMono-Medium.ttf" />
    <EmbeddedResource Include="..\shared\thumbs\*.jpg" Link="Card\thumbs\%(Filename)%(Extension)" LogicalName="card/img/thumbs/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- the texts must be the Mac app's (stops the build when one differs) -->
  <Target Name="CheckStrings" BeforeTargets="BeforeBuild" Condition="'$(SkipStringsCheck)' != 'true'">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../tools/check-strings.py&quot;" Condition="'$(OS)' != 'Windows_NT'" />
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\tools\check-strings.py&quot;" Condition="'$(OS)' == 'Windows_NT'" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- What can be checked without Windows, on Linux, before the Windows machines start: the city list and its search,
       time zones, reading MET Norway's forecast, the weather's rules. The app's own code (Hidamari/Core), compiled in. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Hidamari\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <None Include="..\Hidamari\Resources\cities.gz" Link="cities.gz" CopyToOutputDirectory="PreserveNewest" />
    <None Include="met\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- stage 4: the shader's numbers for 1015 states, worked out by the Mac's Swift (tools/windows-stage4.swift at first, now Tests/make-reference.sh) -->
    <None Include="lighting.json.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- the Mac's update 1.4 (Tests/make-reference.sh): the shader's numbers above now also hold the new scenes and the
         window in motion; the motion's clocks frame by frame; the window's plant in the wind (Core/WindowLeaves.cs) -->
    <None Include="motion.json.gz" CopyToOutputDirectory="PreserveNewest" />
    <None Include="leaves.json.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- the photo plants cut into pieces, embedded as in the app, so WindowLeaves.Rig.FromResource reads them the same way -->
    <EmbeddedResource Include="..\shared\textures\rig*.json" Link="textures\%(Filename)%(Extension)" LogicalName="textures/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows, stage 0: the probe. The wall of the web version under the desktop icons, nothing else.
       The picture is the app's own Sources/Hidamari/Resources/wall.html, linked in at build time, never copied. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HidamariProbe</AssemblyName>
    <RootNamespace>HidamariProbe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.0.1</Version>
    <Product>Hidamari probe</Product>
    <Company>Hidamari</Company>
    <!-- lets the project build on any machine, the probe still runs on Windows only -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- One file to hand over: dotnet publish -c Release -r win-x64 (see README.md) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Sources\Hidamari\Resources\wall.html" Link="wall.html" LogicalName="wall.html" />
  </ItemGroup>

</Project>
